{
  "name": "dsh-plugin-reply-with-images",
  "version": "0.1.6",
  "description": "Add real, context-aware reference images to DeepSeek Harness replies — portrait tables, 3-image collages, multi-angle strips & durable attachments",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "deepseek-plugin",
    "cordis",
    "cordis-plugin",
    "ai-agent",
    "llm",
    "image-search",
    "illustrated-answers",
    "markdown-images",
    "rich-media",
    "wikimedia",
    "reply-with-images"
  ],
  "homepage": "https://github.com/TreatTrick/dsh-plugin-reply-with-images#readme",
  "bugs": {
    "url": "https://github.com/TreatTrick/dsh-plugin-reply-with-images/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TreatTrick/dsh-plugin-reply-with-images.git"
  },
  "author": "TreatTrick",
  "icon": "assets/icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run check:client",
    "check:client": "tsx scripts/checkClientBundle.ts",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:generate": "tsx scripts/generatePreview.ts",
    "preview:client": "npm run build && tsx scripts/clientPreview.ts",
    "analyze:session": "tsx scripts/analyzeSession.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.3.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment-local": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
